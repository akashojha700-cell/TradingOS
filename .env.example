# ---------------------------------------------------------------------------
# TradingOS - Example environment configuration
# Copy to `.env` and adjust for your local environment.
# Never commit a real `.env` file.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME=TradingOS
APP_VERSION=0.1.0
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database -------------------------------------------------------------
# SQLite file lives under ./storage by default
DATABASE_URL=sqlite:///./storage/tradingos.db
DATABASE_ECHO=false

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                 # true for JSON logs (prod), false for console

# --- CORS -----------------------------------------------------------------
CORS_ALLOW_ORIGINS=*

# --- Ingest (Sprint 1+) ---------------------------------------------------
# Optional shared secret for the TradingView webhook.
# When empty: webhook is open (use in local dev only).
# When set:   callers must send `X-Webhook-Secret: <value>`.
TRADINGVIEW_WEBHOOK_SECRET=

# --- Reserved (used by future sprints; safe to leave blank for now) -------
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434
# AI_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
