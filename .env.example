# ---------------------------------------------------------------------------
# TradingOS - Example environment configuration
# Copy to `.env` and adjust for your local environment.
# Never commit a real `.env` file.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME=TradingOS
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/tradingos.db
DATABASE_ECHO=false

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                 # true for JSON logs (prod)

# --- CORS -----------------------------------------------------------------
CORS_ALLOW_ORIGINS=*

# --- Ingest ---------------------------------------------------------------
# Optional shared secret for the TradingView webhook. Empty = open (dev only).
TRADINGVIEW_WEBHOOK_SECRET=

# --- AI Provider ----------------------------------------------------------
# Which provider to use for analysis. Supported: mock, ollama
AI_PROVIDER=mock

# Ollama configuration.
# IMPORTANT: On Windows/Mac hosts, Docker containers cannot reach 127.0.0.1
# of the host. Use host.docker.internal to reach the host's Ollama daemon.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# HTTP timeout for the Ollama /api/generate call, in seconds. This is a READ
# timeout: a local model streams nothing until generation finishes, so it must
# comfortably exceed the model's full generation time. Reasoning models
# (qwen3-thinking, gpt-oss, deepseek-r1) on modest hardware can take 2+ minutes
# — measured ~124s here, so 300 leaves safe headroom. Raise further if needed.
# Both env var names are accepted; OLLAMA_TIMEOUT is the canonical short form.
OLLAMA_TIMEOUT=300
# Deprecated alias (still honoured for back-compat):
# OLLAMA_TIMEOUT_SECONDS=300

# --- Reserved (future sprints) --------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
